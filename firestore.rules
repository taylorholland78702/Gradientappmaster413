rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every read/write this app makes is scoped to users/{uid}/... using
    // the signed-in Firebase Auth uid (anonymous or email/password) — see
    // usePresets.ts and useAuth.ts. Mirror that here: a user can only ever
    // touch their own subtree.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
